<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <!-- <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css"> -->
    <link rel="stylesheet" href="/static/css/steyle.css">
    <title>MiracAkademi</title>
</head>

<body>
     <%- include('../partial/nav') %>
    <section class="stil">
        <!-- Üstteki kart -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Kariyerinizi geleceğe hazırlayın</h5>
                <p class="card-text">
                    200+ birinci sınıf üniversite ve markadan çevrimiçi kurslarla bir sonraki kariyer hamlenizi yapın.
                </p>
                <a href="/courses/kurslar" class="card-link">Kayıt Ol</a>
            </div>
        </div>

        <!-- Alttaki uzun kart -->
    </section>
    <div class="card-1">
        <div class="card-body-1">
            <h5 class="card-title-1">Bugün kendinize yatırım yapın ve Kursları inceleyin</h5>
            <a href="/courses/kurslar" class="btn btn-primary">Kurslar</a>
        </div>
    </div>

    <section class="neden-biz">
        <h2>Neden <span>Miraç Akademi</span>?</h2>
        <div class="neden-container">
            <div class="neden-card">
                <h3>Modern Eğitim İçeriği</h3>
                <p>HTML, CSS, JavaScript, React ve Node.js gibi güncel teknolojilerle, yazılım dünyasının ihtiyaçlarına
                    uygun içerikler sunuyoruz.</p>
            </div>

            <div class="neden-card">
                <h3>Pratik Odaklı Öğrenme</h3>
                <p>Gerçek projelerle çalışarak yalnızca teorik değil, uygulamalı deneyim de kazanırsınız.</p>
            </div>

            <div class="neden-card">
                <h3>Ulaşılabilir Eğitim</h3>
                <p>Her seviyeden öğrenci için sade, anlaşılır ve herkesin kolayca erişebileceği bir öğrenme ortamı
                    sağlıyoruz.</p>
            </div>

        </div>
    </section>

    <section class="cardlar">
        <div class="card-class">
            <h2 class="section-title">Popüler Kurslar</h2>
            <!-- Java Kartı -->
            <div class="card1">
                <img src="/static/images/java.webp" class="card-img-top" alt="Java">
                <div class="card1-body">
                    <h5 class="card1-title">Java</h5>
                    <p class="card1-text">Teori ve pratiği bir arada öğren, profesyonelliğe doğru adım adım ilerle.</p>
                    <a href="/courses/java" class="btn1">Kursa Git</a>
                </div>
            </div>

            <!-- JavaScript Kartı -->
            <div class="card1">
                <img src="/static/images/javascript.png" class="card-img-top" alt="JavaScript">
                <div class="card1-body">
                    <h5 class="card1-title">JavaScript</h5>
                    <p class="card1-text">Web geliştirme ve frontend ile backend arasında güçlü bir temel oluştur.</p>
                    <a href="/courses/javascript" class="btn1">Kursa Git</a>
                </div>
            </div>

            <!-- Node.js Kartı -->
            <div class="card1">
                <img src="/static/images/nodejs.jpg" class="card-img-top" alt="Node.js">
                <div class="card1-body">
                    <h5 class="card1-title">Node.js</h5>
                    <p class="card1-text">Sunucu tarafı programlama ve backend geliştirmeyi pratikle öğren.</p>
                    <a href="/courses/nodejs" class="btn1">Kursa Git</a>
                </div>
            </div>
        </div>
    </section>
    <section class="blog-makaleler">
        <h2>Blog & Makaleler</h2>
        <div class="blog-container">
            <div class="blog-card">
                <img src="/static/images/react.png" alt="Blog 1">
                <h3>React ile Hızlı Başlangıç</h3>
                <p>React öğrenmeye başlamak isteyenler için adım adım rehber ve ipuçları.</p>
                <a href="/users/React-bilgilendirme" class="btn-blog">Devamını Oku</a>
            </div>
            <div class="blog-card">
                <img src="/static/images/nodejs.jpg" alt="Blog 2">
                <h3>Node.js ile Backend Geliştirme</h3>
                <p>Sunucu tarafı geliştirme için temel kavramlar ve pratik örnekler.</p>
                <a href="/users/node-js-bilgilendirme" class="btn-blog">Devamını Oku</a>
            </div>
            <div class="blog-card">
                <img src="/static/images/javascript.png" alt="Blog 3">
                <h3>JavaScript ile Etkileşimli Web</h3>
                <p>Dinamik web sayfaları oluşturmak için önemli JavaScript yöntemleri.</p>
                <a href="/users/javascript" class="btn-blog">Devamını Oku</a>
            </div>
        </div>
    </section>

    <%- include('../partial/footer') %>

</body>

</html>