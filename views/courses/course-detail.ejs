<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/static/css/alanlar.css">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f7fa;
            margin: 0;
            padding: 0;
            color: #333;
        }

        .course-container {
            display: flex;
            max-width: 1200px;
            margin: 50px auto;
            gap: 30px;
            padding: 20px;
        }

        .course-main {
            flex: 3;
            background: #fff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .course-title {
            font-size: 2rem;
            color: #0d6efd;
            margin-bottom: 15px;
        }

        .course-description {
            margin-bottom: 20px;
            line-height: 1.6;
            color: #555;
        }

        .video-wrapper {
            border-radius: 15px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        video {
            width: 100%;
            border-radius: 15px;
        }

        .video-placeholder {
            background: #eef2f7;
            border-radius: 15px;
            padding: 40px 20px;
            text-align: center;
            color: #666;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .course-sidebar {
            flex: 1;
            background: #fff;
            padding: 20px 25px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            height: fit-content;
        }

        .course-sidebar h2 {
            margin-bottom: 15px;
            color: #0d6efd;
        }

        .course-sidebar ul {
            list-style: none;
            padding: 0;
        }

        .course-sidebar li {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .other-courses {
            margin-top: 25px;
        }

        .other-courses a {
            color: #0d6efd;
        }

        @media(max-width: 900px) {
            .course-container {
                flex-direction: column;
            }

            .course-sidebar {
                margin-top: 20px;
            }
        }
    </style>
    <title><%= course.baslik %> - MiracAkademi</title>
</head>

<body>
    <%- include('../partial/nav') %>
    <div class="course-container">
        <div class="course-main">
            <h1 class="course-title"><%= course.baslik %></h1>
            <p class="course-description"><%= course.aciklama %></p>

            <div class="video-wrapper">
                <% if (course.video) { %>
                <video controls width="100%">
                    <source src="<%= course.video %>" type="video/mp4">
                    Tarayıcınız video etiketini desteklemiyor.
                </video>
                <% } else { %>
                <div class="video-placeholder">
                    <i class="fa-solid fa-video fa-2x"></i>
                    <p>Video içeriği yakında eklenecek.</p>
                </div>
                <% } %>
            </div>
        </div>

        <div class="course-sidebar">
            <h2>Modüller</h2>
            <ul>
                <% course.modules.forEach(function(modul, index) { %>
                <li><a href="#"><%= index + 1 %>. <%= modul %></a></li>
                <% }); %>
            </ul>

            <div class="other-courses">
                <h2>Diğer Kurslar</h2>
                <ul>
                    <% courses.filter(function(c) { return c.id !== course.id; }).slice(0, 5).forEach(function(c) { %>
                    <li><a href="<%= c.link %>"><%= c.baslik %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </div>

    <%- include('../partial/footer') %>
</body>

</html>
