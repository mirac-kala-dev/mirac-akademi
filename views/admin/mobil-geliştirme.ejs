<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/static/css/alanlar.css">
    <title>MiracAkademi</title>
</head>

<body>
    <%- include('../partial/nav') %>

        <section class="bolme-1">
            <div class="bilgiler">
                <h1 class="H1">Mobil Geliştirme</h1>
                <p>
                    <strong>Miraç Akademi</strong> olarak, mobil uygulama geliştirmek isteyen herkes için kapsamlı bir
                    öğrenme
                    ortamı sunuyoruz. Android ve iOS platformları için Java, Kotlin ve Flutter gibi popüler
                    teknolojileri adım adım
                    öğreterek öğrencilerimizin sıfırdan profesyonel mobil uygulamalar geliştirebilmesini hedefliyoruz.
                    Kurslarımızda
                    sadece teorik bilgiler değil, aynı zamanda gerçek dünyadan alınmış projelerle pratik yapma imkânı da
                    sunulmaktadır. Bu sayede öğrencilerimiz hem frontend hem backend tarafında güçlü bir temel
                    oluşturur.
                    <strong>Miraç Akademi</strong>’de mobil geliştirme; sadece uygulama yapmak değil, yaratıcı fikirleri
                    kullanıcı
                    deneyimiyle buluşturma sanatıdır.
                </p>
            </div>
        </section>


        <section class="cardlar">
            <div class="card-class">
                <!-- Web Geliştirme Kartı -->

                <% webb.forEach(web=> { %>
                    <div class="card1">
                        <img src="/static/images/<%= web.img %>" class="card-img-top" alt="<%= web.baslik %>">
                        <div class="card1-body">
                            <h5 class="card1-title">
                                <%= web.baslik %>
                            </h5>
                            <p class="card1-text">
                                <%= web.aciklama %>
                            </p>
                            <a href="<%= web.link %>" class="btn1">Kursa Git</a>
                        </div>
                    </div>
                    <% }) %>

            </div>
        </section>

        <%- include('../partial/footer') %>
</body>

</html>